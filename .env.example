# ============================================================
# Katch Studio — environment variables
# Copy this file to `.env` and fill in the Firebase values to
# sync projects to Firestore. Without these, the studio uses
# local browser storage (zero-config default).
#
# Get the first three values from:
#   Firebase Console → Project settings → Your apps → Web app → SDK setup (Config)
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Workspace id inside Firestore — one workspace per team.
# Defaults to "katch-prod" when left empty.
VITE_FIREBASE_WORKSPACE_ID=katch-prod

# Sentry DSN (optional) — error + performance monitoring for the studio itself.
# Get it from https://sentry.io → Create project → Client Keys (DSN).
# Left empty = no reporting.
VITE_SENTRY_DSN=

# ============================================================
# DEPLOYMENT BACKEND — SERVER-SIDE ONLY. ⚠️ NEVER rename these
# to VITE_* and never put these values in frontend code. They
# are read exclusively by server/index.mjs (and api/index.js on
# Vercel). The browser only ever sees ids, names and URLs.
#
# Without credentials the backend runs in MOCK mode — deployments
# are simulated and the UI shows a "Development Mode" badge.
# ============================================================

# "mock" forces the simulated backend; "live" forces real APIs;
# anything else (default) auto-detects from the credentials below.
DEPLOYMENT_MODE=

# --- GitHub (one of the two options) --------------------------
# Option A — GitHub App (recommended):
#   GitHub → Settings → Developer settings → GitHub Apps → New
#   Permissions: Contents/Administration/Commit statuses (R/W),
#   Metadata (R). Install the app on your account/org.
#   "Install App" button appears in the studio automatically.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Option B — fine-grained personal access token (quickest):
#   Repositories: All repositories · Permissions: Contents R/W,
#   Administration R/W, Metadata R.
GITHUB_PAT=

# --- Vercel ----------------------------------------------------
# Vercel → Account Settings → Tokens → Create. Scope: your account.
VERCEL_TOKEN=
# Optional — only for team accounts: Vercel → Team → Settings → Team ID
VERCEL_TEAM_ID=

# --- Netlify ----------------------------------------------------
# Netlify → User settings → Applications → Personal access tokens → New.
NETLIFY_AUTH_TOKEN=
