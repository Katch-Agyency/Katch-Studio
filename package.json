{
  "name": "katch-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Katch Studio — internal website production system for the Katch web agency",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "export:sources": "node scripts/generate-export-sources.mjs",
    "predev": "npm run export:sources",
    "dev": "vite",
    "prebuild": "npm run export:sources",
    "build": "tsc --noEmit && vite build && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:data": "esbuild src/scripts/smoke.ts --bundle --platform=node --format=esm --alias:@=./src --loader:.jpg=dataurl --outfile=/tmp/katch-smoke.mjs && node /tmp/katch-smoke.mjs",
    "pretest:render": "npm run export:sources",
    "test:render": "node scripts/render-test.mjs",

    "pretest:export": "npm run export:sources",
    "test:export": "node scripts/export-test.mjs",

    "test:server": "node scripts/server-test.mjs",
    "test:scaffold": "node scripts/scaffold-verify.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "typescript": "^6.0.3",
    "vite": "^6.4.3"
  }
}
