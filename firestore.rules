rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Katch Studio — Firestore security rules
    //
    // Data layout (per workspace):
    //   workspaces/{workspaceId}/projects/{projectId}  — project configs
    //   workspaces/{workspaceId}/drafts/{projectId}    — unsaved editor drafts
    //   workspaces/{workspaceId}/meta/state            — last-opened + seeded flags
    //
    // MVP (single internal team): any signed-in user may read/write.
    // The studio signs in anonymously on boot, so enable
    // Authentication → Sign-in method → Anonymous for these rules to work.
    //
    // TODO (when real accounts & team roles ship):
    //   - require specific auth (e.g. Google) instead of anonymous
    //   - restrict writes to users whose workspace membership doc exists:
    //       allow read, write: if exists(/databases/$(database)/documents/
    //         workspaces/$(workspaceId)/members/$(request.auth.uid));
    // ============================================================

    match /workspaces/{workspaceId} {
      // This single rule covers the workspace doc and every nested
      // collection (projects, drafts, meta) recursively.
      allow read, write: if request.auth != null;

      // ---- Variant: open access — ONLY for a quick local trial.
      // Do NOT deploy this to anything real:
      // allow read, write: if true;
    }
  }
}
